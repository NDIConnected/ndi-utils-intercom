<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>NDIIntercom16Linux</AssemblyName>
    <RootNamespace>NDIIntercom</RootNamespace>
    <Version>1.7.3</Version>
    <AssemblyVersion>1.7.3.0</AssemblyVersion>
    <FileVersion>1.7.3.0</FileVersion>
    <InformationalVersion>1.7.3</InformationalVersion>
    <Authors>NDI</Authors>
    <Product>NDI Intercom16 (Linux)</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1998;CS8618;CS8625;CS8600;CS8604;CS8603;CS8622;CS8612;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="Program.Light.cs" />
    <Compile Remove="Program.Linux.Light.cs" />
    <Compile Remove="TrayApplicationContext.cs" />
    <Compile Remove="Core\AudioEngine.cs" />
    <Compile Remove="Core\AsioManager.cs" />
    <Compile Remove="Core\AsioAudioEngine.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="NDI 6 SDK\**\*.cs" />
    <EmbeddedResource Remove="NDI 6 SDK\**\*" />
    <Content Remove="NDI 6 SDK\**\*" />
    <None Remove="NDI 6 SDK\**\*" />
  </ItemGroup>

  <!-- Optional: msbuild /p:NDI_LINUX_LIB=/path/to/libndi.so to copy next to the published binary -->
  <ItemGroup Condition="'$(NDI_LINUX_LIB)' != '' And Exists('$(NDI_LINUX_LIB)')">
    <None Include="$(NDI_LINUX_LIB)" Link="libndi.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
